# Supabase (placeholder — paste from Supabase dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-anon-key
SUPABASE_SERVICE_ROLE_KEY=placeholder-service-role-key

# Resend (OTP fallback + event reminders)
RESEND_API_KEY=placeholder-resend-key

# Web Push (VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=placeholder-vapid-public
VAPID_PRIVATE_KEY=placeholder-vapid-private
VAPID_SUBJECT=mailto:admin@example.ac.in

# OAuth (Google/GitHub): configured entirely in Supabase Dashboard →
# Authentication → Providers (client ID/secret + redirect URLs).
# No env keys needed. App callback: <origin>/auth/callback.

# Email domain allow-list (comma-separated). Empty = allow any domain.
# Examples: NEXT_PUBLIC_ALLOWED_DOMAINS=gmail.com,outlook.com
#           NEXT_PUBLIC_ALLOWED_DOMAINS=*.ac.in   (campus-only)
NEXT_PUBLIC_ALLOWED_DOMAINS=

# Sentry (re-add @sentry/nextjs when network allows; see TAD §9)
# SENTRY_DSN=
